# Salin file ini menjadi ".env" lalu isi dengan kredensial Supabase Anda.
# Jika DIBIARKAN KOSONG, aplikasi otomatis berjalan dalam MODE DEMO (data di browser).
#
# Cara mendapatkan nilai ini:
# 1. Buat akun gratis di https://supabase.com
# 2. Buat project baru (gratis, tanpa kartu kredit)
# 3. Buka Settings > API
# 4. Salin "Project URL" dan "anon public" key ke bawah ini.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
